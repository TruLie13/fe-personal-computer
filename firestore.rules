rules_version = '2';

// Owner + public-read ACL.
// Length caps mirror src/lib/contentLimits.ts (parity test enforced).
// Social creates + desktop FS layout: Admin routes (/api/social/*, /api/desktop/layout).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function stringMax(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    function optionalStringMax(field, maxLen) {
      return field == null || stringMax(field, maxLen);
    }

    // Soft-delete: only deletedAt may change, and it must become non-null.
    function onlySoftDelete() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deletedAt'])
        && request.resource.data.deletedAt != null;
    }

    function validUserProfileFields() {
      return stringMax(request.resource.data.username, 20)
        && stringMax(request.resource.data.displayName, 25)
        && stringMax(request.resource.data.computerName, 24)
        && stringMax(request.resource.data.bio, 500)
        && stringMax(request.resource.data.avatarColor, 32)
        && optionalStringMax(request.resource.data.avatarUrl, 2048)
        && stringMax(request.resource.data.wallpaper, 2048)
        && stringMax(request.resource.data.titleBarColor, 32)
        && request.resource.data.contentDark is bool
        && (
          !('taskbarHeight' in request.resource.data)
          || (
            request.resource.data.taskbarHeight is number
            && request.resource.data.taskbarHeight >= 28
            && request.resource.data.taskbarHeight <= 72
          )
        );
    }

    function validFileFields() {
      return stringMax(request.resource.data.title, 120)
        && stringMax(request.resource.data.slug, 120)
        && request.resource.data.type in ['text', 'folder']
        && (
          request.resource.data.type == 'folder'
          || (
            request.resource.data.content is string
            && request.resource.data.content.size() <= 20000
          )
        );
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && username.size() >= 2
        && username.size() <= 20;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validUserProfileFields();
      allow update: if isOwner(uid) && validUserProfileFields();
      allow delete: if false;

      match /files/{fileId} {
        // Private text hidden from guests; folders visible for navigation.
        allow read: if isOwner(uid)
          || resource.data.isPublic == true
          || resource.data.type == 'folder';
        // Claim seeds Documents only; all other FS writes use Admin layout API.
        allow create: if isOwner(uid)
          && fileId == 'documents'
          && validFileFields()
          && request.resource.data.type == 'folder';
        allow update, delete: if false;
      }

      match /favorites/{targetUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && stringMax(request.resource.data.targetUsername, 20);
        allow delete: if isOwner(uid);
      }
    }

    // Creates go through Admin (/api/social/*) after UTC-day quota checks.
    match /bbsNotes/{noteId} {
      allow read: if true;
      allow create: if false;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && onlySoftDelete();
      allow delete: if false;
    }

    match /storyComments/{commentId} {
      allow read: if true;
      allow create: if false;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && onlySoftDelete();
      allow delete: if false;
    }

    match /guestbookEntries/{entryId} {
      allow read: if true;
      allow create: if false;
      allow update: if signedIn()
        && onlySoftDelete()
        && (resource.data.authorUid == request.auth.uid
          || resource.data.hostUid == request.auth.uid);
      allow delete: if false;
    }

    match /publicStories/{storyId} {
      allow read: if true;
      // Index docs written by Admin layout / social paths; clients may delete own.
      allow create, update: if false;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
