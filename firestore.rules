rules_version = '2';

// Owner + public-read ACL (see docs/db-agent.md).
// Keep emulators / early launch usable; tighten daily quotas with Functions later.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /files/{fileId} {
        allow read: if true;
        allow write: if isOwner(uid);
      }

      match /favorites/{targetUid} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }
    }

    match /bbsNotes/{noteId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.body.size() <= 1000;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid;
      allow delete: if false;
    }

    match /storyComments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid;
      allow delete: if false;
    }

    match /guestbookEntries/{entryId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid != request.resource.data.hostUid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 400;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid;
      allow delete: if false;
    }

    match /publicStories/{storyId} {
      allow read: if true;
      // `write` alone rejects deletes: request.resource is unset on delete.
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
